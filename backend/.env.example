# URL PostgreSQL fournie par Neon (gardez le ?sslmode=require)
DATABASE_URL=postgresql://utilisateur:motdepasse@ep-xxxx.eu-central-1.aws.neon.tech/immogest?sslmode=require
# Identifiants de connexion à l'application
APP_USER=philippe
APP_PASSWORD=choisissez-un-mot-de-passe-long
# Chaîne aléatoire longue pour signer les jetons de connexion
JWT_SECRET=remplacez-par-une-longue-chaine-aleatoire
# Adresse de votre site GitHub Pages (sans chemin). Plusieurs origines : séparez par des virgules
CORS_ORIGINS=https://votre-compte.github.io,http://localhost:4200
